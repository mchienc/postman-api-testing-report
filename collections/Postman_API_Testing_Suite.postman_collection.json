{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Postman API Testing Suite - Demo JSONPlaceholder",
		"description": "Bộ kiểm thử API tự động với Postman dành cho bài tập kiểm thử API RESTful sử dụng JSONPlaceholder API làm SUT (System Under Test).\nBao gồm đầy đủ các phương thức HTTP: GET, POST, PUT, PATCH, DELETE và các kịch bản Positive/Negative Testing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET Requests",
			"item": [
				{
					"name": "TC01 - GET All Posts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is acceptable (< 2000ms)\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Response returns a list with 100 posts\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"    pm.expect(jsonData.length).to.eql(100);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts"
							]
						},
						"description": "Lấy danh sách tất cả các bài viết"
					},
					"response": []
				},
				{
					"name": "TC02 - GET Post by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify Post ID matches requested ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(parseInt(pm.environment.get(\"postId\") || 1));",
									"});",
									"",
									"pm.test(\"Verify Post Schema contains all required fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"userId\");",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"    pm.expect(jsonData).to.have.property(\"title\");",
									"    pm.expect(jsonData).to.have.property(\"body\");",
									"    pm.expect(jsonData.title).to.be.a(\"string\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/{{postId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"{{postId}}"
							]
						},
						"description": "Lấy thông tin chi tiết một bài viết theo ID sử dụng biến môi trường"
					},
					"response": []
				},
				{
					"name": "TC03 - GET Comments for Post (Filter with Query Param)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify all returned comments belong to postId 1\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"    jsonData.forEach(function(comment) {",
									"        pm.expect(comment.postId).to.eql(1);",
									"        pm.expect(comment.email).to.include(\"@\");",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/comments?postId=1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"comments"
							],
							"query": [
								{
									"key": "postId",
									"value": "1"
								}
							]
						},
						"description": "Lấy danh sách bình luận của bài viết có postId = 1"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. POST Requests",
			"item": [
				{
					"name": "TC04 - POST Create New Post",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.variables.set(\"randomTitle\", \"Kiem thu tu dong voi Postman \" + Math.floor(Math.random() * 1000));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains created ID and correct data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"    pm.expect(jsonData.title).to.eql(pm.variables.get(\"randomTitle\"));",
									"    pm.expect(jsonData.userId).to.eql(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"{{randomTitle}}\",\n    \"body\": \"Noi dung bai viet kiem thu thuc hien boi Postman Automated Test\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts"
							]
						},
						"description": "Tạo một bài viết mới với dữ liệu ngẫu nhiên tạo bởi Pre-request Script"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. PUT & PATCH Requests",
			"item": [
				{
					"name": "TC05 - PUT Update Post (Full Update)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response returns updated values\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.eql(\"Tieu de da duoc cap nhat toan dien qua PUT\");",
									"    pm.expect(jsonData.body).to.eql(\"Noi dung moi hoan toan\");",
									"    pm.expect(jsonData.id).to.eql(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1,\n    \"title\": \"Tieu de da duoc cap nhat toan dien qua PUT\",\n    \"body\": \"Noi dung moi hoan toan\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Cập nhật toàn bộ thuộc tính của bài viết số 1"
					},
					"response": []
				},
				{
					"name": "TC06 - PATCH Update Post (Partial Update)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response returns updated title only\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.eql(\"Tieu de cap nhat mot phan qua PATCH\");",
									"    pm.expect(jsonData).to.have.property(\"body\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Tieu de cap nhat mot phan qua PATCH\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Cập nhật một phần thuộc tính (chỉ trường title)"
					},
					"response": []
				}
			]
		},
		{
			"name": "4. DELETE Request",
			"item": [
				{
					"name": "TC07 - DELETE Post by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response body is empty object\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(Object.keys(jsonData).length).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"1"
							]
						},
						"description": "Xoá bài viết theo ID"
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Negative Testing",
			"item": [
				{
					"name": "TC08 - GET Non-existent Post (404 Not Found)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 Not Found\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Response body is empty object on 404\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(Object.keys(jsonData).length).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/999999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"posts",
								"999999"
							]
						},
						"description": "Kiểm thử trường hợp gửi yêu cầu lấy ID không tồn tại"
					},
					"response": []
				}
			]
		}
	]
}
